# Copy to .env and adjust. Never commit the real .env file.

NODE_ENV=development
PORT=4000

# --- MySQL (values are consumed by docker-compose.yml) ---
MYSQL_ROOT_PASSWORD=root_dev_password
MYSQL_DATABASE=notes_app
MYSQL_USER=notes
MYSQL_PASSWORD=notes_dev_password

# Connection string used by the server (Prisma is added in PR #3)
DATABASE_URL="mysql://notes:notes_dev_password@localhost:3306/notes_app"

# --- Auth (used from PR #4 onwards) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string

# --- CORS ---
CLIENT_ORIGIN=http://localhost:5173
